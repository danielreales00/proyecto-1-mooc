                ]
              }
            }
          ]
        },
        {
          "name": "GET /me tras cerrar sesión — revocación inmediata",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{session_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "Borrar la clave de Redis surte efecto en la petición siguiente, sin ventana de gracia. Es lo que el segmento 1 exige demostrar (ADR-0006)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
