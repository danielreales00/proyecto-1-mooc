# Configuración local. Copiar a .env; .env no se versiona (ADR-0010).

# --- puertos publicados en el host ------------------------------------------
# Rango propio del proyecto, para poder convivir con otros stacks de Docker en
# la misma máquina. Cambiarlos aquí no toca nada dentro de la red de Compose.
API_PORT=8090
MAILPIT_UI_PORT=8026
MAILPIT_SMTP_PORT=1026
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
POSTGRES_PORT=5433
REDIS_PORT=6380
PROMETHEUS_PORT=9091
GRAFANA_PORT=3002

# --- aplicación -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
# json en Compose; gcp en Cloud Run, que espera severity y message.
LOG_FORMAT=json
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8090

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=mooc
POSTGRES_PASSWORD=mooc_local_dev
POSTGRES_DB=mooc
DATABASE_URL=postgres://mooc:mooc_local_dev@postgres:5432/mooc?sslmode=disable
# Pool POR INSTANCIA. En Cloud Run se multiplica por el número de
# instancias y es fácil agotar Cloud SQL (ADR-0015, D6).
DB_MAX_CONNS=10

# --- Redis ------------------------------------------------------------------
# Una base lógica por uso: no se comparte espacio de claves (ADR-0004).
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
# Lo exige Memorystore con cifrado en tránsito.
REDIS_TLS=false
REDIS_QUEUE_DB=0
REDIS_SESSION_DB=1
REDIS_CACHE_DB=2
REDIS_LIMIT_DB=3

# --- Almacenamiento de objetos (MinIO en local, GCS en GCP) -----------------
MINIO_ROOT_USER=mooc_minio
MINIO_ROOT_PASSWORD=mooc_minio_local_dev
# s3 (MinIO y compatibles) o gcs. Única variable que nombra al proveedor
# de almacenamiento (ADR-0015, D1).
OBJECT_STORE=s3
S3_ENDPOINT=minio:9000
# Endpoint con el que se FIRMAN las URLs. La API habla con minio:9000 dentro de
# Compose, pero quien abre una URL firmada está fuera y ese nombre no resuelve.
S3_PUBLIC_ENDPOINT=localhost:9010
S3_ACCESS_KEY=mooc_minio
S3_SECRET_KEY=mooc_minio_local_dev
S3_USE_SSL=false
S3_BUCKET_ORIGINALS=mooc-originals
S3_BUCKET_DERIVED=mooc-derived
S3_BUCKET_BADGES=mooc-badges
S3_BUCKET_QUARANTINE=mooc-quarantine

# --- Correo (Mailpit en local) ----------------------------------------------
SMTP_ADDR=mailpit:1025
CLAMAV_ADDR=clamav:3310
MAIL_FROM=no-reply@mooc.local

# --- Sesiones y tokens ------------------------------------------------------
SESSION_TTL=12h
SESSION_MAX_TTL=720h
VERIFY_TOKEN_TTL=24h
RESET_TOKEN_TTL=1h

# --- Workers ----------------------------------------------------------------
WORKER_CONCURRENCY=20
WORKER_QUEUES=critical=6,default=3,bulk=1
