# Proxy de entrada. Existe por dos razones:
#
# 1. La API no publica puerto propio, así que `--scale api=N` funciona sin
#    colisiones: el proxy reparte entre las instancias (CE-01).
# 2. Es donde terminará TLS (RT-06). En GCP lo sustituye Cloud Load Balancing
#    sin tocar código (ADR-0010).

{
	admin off
	auto_https off
}

:8080 {
	log {
		output stdout
		format json
	}

	# La documentación navegable del contrato, en el MISMO origen que la API:
	# así el botón «Try it out» de Swagger UI llama a los endpoints de verdad
	# sin necesidad de abrir CORS.
	# `handle`, no `handle_path`: swagger-ui sirve EN /docs (su BASE_URL), así
	# que quitarle el prefijo le haría devolver 404.
	handle /docs* {
		reverse_proxy swagger:8080
	}

	handle {
		reverse_proxy {
			# Resolución dinámica: Docker devuelve una A por instancia de
			# `api`, y el refresco hace que escalar en caliente se note sin
			# reiniciar.
			dynamic a {
				name api
				port 8080
				refresh 5s
			}
			lb_policy round_robin

			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
