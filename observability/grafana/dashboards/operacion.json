{
  "title": "MOOC · Operación",
  "uid": "mooc-operacion",
  "tags": [
    "mooc"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Tolerancia a fallos",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 1,
      "title": "Dead-letter queue — dispara la alerta del §6",
      "description": "Tras tres reintentos fallidos el trabajo llega aquí. Cualquier valor por encima de cero dispara la alerta.",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "increase(jobs_dead_letter_total[5m])",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Entregas duplicadas descartadas — evidencia de idempotencia",
      "description": "Sube cuando el reclamo atómico impide una segunda salida (CA-03).",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "increase(jobs_duplicate_skipped_total[5m])",
          "legendFormat": "{{type}}",
          "refId": "A"
        },
        {
          "expr": "increase(jobs_reaped_total[5m])",
          "legendFormat": "recuperados por el reaper",
          "refId": "B"
