# Entorno
.env
*.local

# Go
/backend/bin/
/backend/tmp/
*.test
coverage.out

# Datos de contenedores
/data/
/backups/

# Intermedios del PDF de los informes (SVG, PDF de diagramas y Markdown
# preprocesado). El .md y el .pdf del informe sí se versionan.
/arquitectura/recursos/informe-*/

# Artefactos de pruebas
/scripts/out/
*.log

# Editores
.vscode/
.idea/
.DS_Store


# Terraform: proveedores descargados y planes locales. El lock sí se versiona.
.terraform/
*.tfplan
# Correos de personas y cuenta de facturación; se versiona el .example.
infra/environments/*/privado.auto.tfvars

# Archivos de las pruebas de carga: se regeneran con make medios-carga.
capacity-planning/medios/*.mp4
capacity-planning/medios/manifiesto.jsonl

# Guiones y reparto de los videos: se trabajan en local, no se versionan.
demo/guion.md
demo/guion-entrega2.md
demo/reparto.md

# Herramientas de desarrollo de la interfaz
frontend/node_modules/
frontend/test-results/
frontend/playwright-report/

# Metadatos de descarga que Windows deja junto a los archivos en WSL
*:Zone.Identifier

# Análisis de calidad (make calidad): directorio de trabajo del scanner y
# cobertura de la interfaz. La exportación en docs/entrega3/calidad sí se versiona.
.scannerwork/
frontend/lcov.info
